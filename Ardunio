int ledPins[] = {8,9,10,11,12};

void setup()
{
    Serial.begin(9600);
    for(int i = 0; i < 5; i++)
    {
        pinMode(ledPins[i], OUTPUT);
    }
}

void lop()
{
    if (serial.available() >= 5)
    {
        for(int i=0;i<5;i++)
        {
            int fingerstate = Serial.rad();
            digitalWrite(ledPins[i],fingerstate == 1 ? HIGH : LOW);
        }
    }
}